{
  "extends": "@via/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"],
    "jsx": "react-jsx",
    // Resolve packages as the browser does, as Vite builds this app for one.
    "customConditions": ["browser"]
  },
  "include": [
    "src",
    "test",
    "scripts",
    "embedded.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "via-version.ts"
  ]
}
