{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    "npm": {
      "entry": ["via/bin/via.js"]
    },
    "apps/web": {
      "entry": ["src/router.tsx", "src/routes/**/*.tsx"]
    },
    "packages/ui": {
      "entry": ["test/build-fixture/main.tsx"],
      "includeEntryExports": false
    },
    "packages/usage": {
      "entry": ["scripts/update-prices.ts"]
    }
  },
  "ignoreDependencies": ["@effect/language-service"],
  "ignore": ["tools/oxlint/anti-slop/**", "apps/web/embedded.d.ts"]
}
