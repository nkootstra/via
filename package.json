{
  "name": "via",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "npm"
    ],
    "catalog": {
      "@base-ui/react": "1.9.0",
      "@stylexjs/stylex": "0.19.1",
      "@stylexjs/unplugin": "0.19.1",
      "@testing-library/dom": "10.4.2",
      "@testing-library/react": "16.3.3",
      "@testing-library/user-event": "14.6.7",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "happy-dom": "21.0.1",
      "motion": "14.1.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "vite": "8.3.4",
      "effect": "4.0.3",
      "@effect/platform-bun": "4.0.3",
      "@effect/sql-sqlite-bun": "4.0.3",
      "@effect/vitest": "4.0.3",
      "vitest": "^5.0.4",
      "recharts": "3.10.1",
      "react-is": "19.3.0"
    }
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "build": "turbo run build",
    "smoke": "turbo run smoke",
    "test": "VITEST_MAX_WORKERS=2 turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "prices:update": "bun run --cwd packages/usage prices:update",
    "check": "oxlint --deny-warnings && oxfmt --check && knip && VITEST_MAX_WORKERS=2 turbo run typecheck test"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.4",
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "^1.4.3",
    "knip": "6.41.0",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.3"
  },
  "packageManager": "bun@1.4.3"
}
