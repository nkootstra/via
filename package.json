{
  "name": "via",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "npm"
    ],
    "catalog": {
      "effect": "4.0.0-rc.117",
      "@effect/platform-bun": "4.0.0-rc.117",
      "@effect/vitest": "4.0.0-rc.117",
      "vitest": "^5.0.1"
    }
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "build": "turbo run build",
    "smoke": "turbo run smoke",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "oxlint --deny-warnings && oxfmt --check && knip && turbo run typecheck test"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.85.0",
    "@types/bun": "^1.4.2",
    "knip": "6.38.0",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "turbo": "^2.11.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
