{
  "name": "via",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check && turbo run typecheck test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "turbo": "^2.11.3",
    "typescript": "^5.9.0"
  },
  "packageManager": "bun@1.4.0"
}
